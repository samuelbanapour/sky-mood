<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SkyMood</RootNamespace>
    <AssemblyName>SkyMood.Core</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- This volume creates macOS AppleDouble (._*) sidecar files; keep them out of the build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);._*;**/._*</DefaultItemExcludes>
  </PropertyGroup>

</Project>
