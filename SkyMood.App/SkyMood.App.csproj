<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Platform heads are selected by the custom 'Heads' property so a SINGLE head can be built
      without installing the other platforms' workloads. Override like: -p:Heads=maccatalyst
      (build-app.sh does this for you). Default: android everywhere, plus windows on Windows.
      (Same pattern as the Echoes solution. 'Heads' is ignored by the net10.0 Core project.)
    -->
    <Heads Condition="'$(Heads)' == ''">default</Heads>
    <TargetFrameworks Condition="'$(Heads)' == 'default'">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(Heads)' == 'default' and $([MSBuild]::IsOSPlatform('windows'))">net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(Heads)' == 'android'">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(Heads)' == 'ios'">net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="'$(Heads)' == 'maccatalyst'">net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="'$(Heads)' == 'windows'">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(Heads)' == 'apple'">net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="'$(Heads)' == 'all'">net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SkyMood.App</RootNamespace>

    <!-- App identity -->
    <ApplicationTitle>Sky Mood</ApplicationTitle>
    <ApplicationId>com.gamedevsolo.skymood</ApplicationId>
    <ApplicationIdGuid>7c4b2a1e-9f3d-4b6a-8e2c-1d5f6a7b8c90</ApplicationIdGuid>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Minimum OS versions -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Publisher: the Android head ships under the Play Store identity "Game Dev Solo".
         Every other head inherits "Solo Apps Studio" from Directory.Build.props. -->
    <Company Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">Game Dev Solo</Company>
    <Authors Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">Game Dev Solo</Authors>
    <Copyright Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">© 2026 Game Dev Solo</Copyright>

    <!-- Support every real Android ABI: armeabi-v7a (32-bit — older Fire tablets/phones),
         arm64-v8a (modern devices) and x86_64 (emulators). Without armeabi-v7a, install fails with
         NO_MATCHING_ABIS on 32-bit devices and Play won't serve them. Android head only, so it
         never leaks into the net10.0 Core project. -->
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm;android-arm64;android-x64</RuntimeIdentifiers>

    <!-- Marshal Methods (default-on) AOT-generates the JNI registration stubs instead of registering
         them at runtime. On some 32-bit armeabi-v7a devices (older Fire tablets etc.) that generation
         is broken: libmonodroid.so loads fine but n_onCreate is never wired up, so the app throws
         UnsatisfiedLinkError and dies on first launch. Disabling it falls back to dynamic JNI
         registration, which works on every ABI at a negligible startup-time cost. -->
    <AndroidEnableMarshalMethods Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</AndroidEnableMarshalMethods>

    <!-- Without an explicit candidate list, -p:RuntimeIdentifierOverride=win10-arm64 has nothing
         valid to select and silently falls back to the host RID (win-x64) — both "architectures"
         built identically. Declaring both here is what makes the override actually take effect. -->
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x64;win-arm64</RuntimeIdentifiers>

    <DefaultItemExcludes>$(DefaultItemExcludes);._*;**/._*</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon + splash (generated from SVG by the MAUI build) -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0E1C3A" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0A1428" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET 8+ no longer auto-references this with UseMaui (warning MA002). -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <!-- Native map control for the satellite/weather map (replaces the earlier WebView
         approach) — free/open-source, no API key, supports arbitrary XYZ tile URLs the same
         way Leaflet does, so the same Esri/CARTO/RainViewer tile sources work unchanged. -->
    <!-- Package id is "Mapsui.Maui" — "Mapsui.UI.Maui" is only the internal source-repo project
         name; that id is unlisted on NuGet (confirmed: dotnet restore NU1101, and the search API
         returns zero hits for it) and restore fails. The namespace inside the package is still
         Mapsui.UI.Maui, unchanged — only this Include value needed fixing. -->
    <PackageReference Include="Mapsui.Maui" Version="5.1.0" />
    <PackageReference Include="Mapsui.Nts" Version="5.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkyMood.Core\SkyMood.Core.csproj" />
  </ItemGroup>

  <!--
    Embeds the native SkyMoodWatch companion (see ../SkyMoodWatch/) into this app's device build
    so watchOS recognizes it as a real paired companion (WKCompanionAppBundleIdentifier), not a
    side-loaded standalone app. Hooked via AfterTargets/BeforeTargets rather than by name: the
    obvious-looking extension point "_PostProcessAppBundle" (referenced in CreateAppBundleDependsOn)
    turns out to NOT be an empty stub — the SDK's own legacy tools/msbuild/Xamarin.Shared.targets
    defines a real one there (dSYM generation + native stripping) that's imported after this csproj
    and silently wins MSBuild's "last definition of a Target name" override rule, discarding a
    same-named Target here entirely (confirmed via `-v:diag`: "Overriding target
    '_PostProcessAppBundle' ... with target ... from ... tools/msbuild/Xamarin.Shared.targets").
    AfterTargets/BeforeTargets add to the dependency graph instead of replacing a Target by name, so
    this runs right where intended — after resources/executable are in the bundle, before Codesign —
    without clobbering the SDK's own dSYM/stripping step. Device builds only: simulator Watch apps
    are a different architecture/signing story entirely and aren't handled here.

    SkyMoodWatchAppPath expects a fixed, non-hashed location, so build the watch app with:
      xcodebuild -project SkyMoodWatch.xcodeproj -scheme SkyMoodWatch \
        -destination "generic/platform=watchOS" -derivedDataPath ~/.skymoodwatch-src/build \
        -allowProvisioningUpdates build
    (see SkyMoodWatch/README.md for the full recipe). Xcode's default DerivedData path has a
    project-specific hash suffix that isn't stable across machines/checkouts, hence pinning it.
  -->
  <Target Name="_EmbedSkyMoodWatch"
          AfterTargets="_PostProcessAppBundle"
          BeforeTargets="Codesign"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(RuntimeIdentifier)' == 'ios-arm64'">
    <PropertyGroup>
      <SkyMoodWatchAppPath Condition="'$(SkyMoodWatchAppPath)' == ''">$(HOME)/.skymoodwatch-src/build/Build/Products/Debug-watchos/SkyMoodWatch.app</SkyMoodWatchAppPath>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(SkyMoodWatchAppPath)')">
      <_WatchAppFiles Include="$(SkyMoodWatchAppPath)/**/*" />
    </ItemGroup>
    <Copy Condition="Exists('$(SkyMoodWatchAppPath)')"
          SourceFiles="@(_WatchAppFiles)"
          DestinationFiles="@(_WatchAppFiles->'$(_AppBundlePath)/Watch/SkyMoodWatch.app/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Warning Condition="!Exists('$(SkyMoodWatchAppPath)')"
             Text="SkyMoodWatchAppPath ($(SkyMoodWatchAppPath)) not found -- shipping without the embedded Watch companion. Build SkyMoodWatch first (see SkyMoodWatch/README.md)." />
  </Target>

</Project>
